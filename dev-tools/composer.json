{
    "name": "szeducate/dev-tools",
    "description": "Kulon vendor a lint/static-analysis dev-eszkozoknek, hogy ne keveredjenek a tudatosan trackelt futasideju vendor/-vel (phpoffice/phpspreadsheet).",
    "type": "project",
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpstan/phpstan": "^1.11",
        "szepeviktor/phpstan-wordpress": "^1.3"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
